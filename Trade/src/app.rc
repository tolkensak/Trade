FONT 10, "Arial", 400, 0, 0xCC
BEGIN
    ICON            IDR_MAIN,IDC_STATIC,12,12,20,20
    LTEXT           "Sawda 1.0",IDC_STATIC,44,12,32,8,SS_NOPREFIX
    LTEXT           "© 2012.  By Tolken Ahmetolla.",IDC_STATIC,44,28,103,8
    DEFPUSHBUTTON   "OK",IDOK,137,48,50,14
END

